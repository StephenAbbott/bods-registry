{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StephenAbbott/bods-registry/extensions/registry.schema.json",
  "title": "BODS extensions registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "updated", "extensions"],
  "properties": {
    "$schema": { "type": "string" },
    "registry_version": { "type": "string", "const": "1.0" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "description", "url", "documentation_url", "maintainer", "bods_versions", "category", "status", "first_registered"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 100 },
          "description": { "type": "string", "minLength": 20, "maxLength": 600 },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Base URL of the extension: appending extension.json, README.md or schema/<file> must retrieve those files."
          },
          "documentation_url": { "type": "string", "format": "uri" },
          "repository_url": { "type": "string", "format": "uri" },
          "maintainer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "format": "uri" }
            }
          },
          "bods_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          },
          "category": {
            "type": "string",
            "enum": ["assets", "documents", "projects", "payments", "sanctions", "agents", "political-exposure", "procurement", "verification", "identifiers", "other"]
          },
          "status": { "type": "string", "enum": ["draft", "community", "deprecated"] },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "default": []
          },
          "used_by": {
            "type": "array",
            "uniqueItems": true,
            "description": "Implementation profile slugs (files in implementations/) that use this extension.",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "default": []
          },
          "copy_held_here": {
            "type": "boolean",
            "description": "True when a copy of the extension is kept under extensions/<slug>/ in this repository.",
            "default": false
          },
          "first_registered": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
